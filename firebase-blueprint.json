{
  "entities": {
    "Station": {
      "title": "Station",
      "description": "A scientific heritage station in the 12-station STEM passport expedition.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 16, "pattern": "^[0-9]{2}$" },
        "soThuTu": { "type": "number" },
        "cumId": { "type": "string", "enum": ["cum-1", "cum-2", "cum-3"] },
        "cum": { "type": "string", "maxLength": 160 },
        "ten": { "type": "string", "minLength": 1, "maxLength": 180 },
        "diaPhuong": { "type": "string", "maxLength": 160 },
        "anh": { "type": "string", "maxLength": 350000 },
        "moTaNgan": { "type": "string", "maxLength": 600 },
        "kienThuc": { "type": "object" },
        "video": { "type": "object" },
        "autoplay": { "type": "boolean" },
        "cauHoi": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "soThuTu", "cumId", "cum", "ten", "diaPhuong", "anh", "moTaNgan", "kienThuc", "video", "cauHoi", "updatedAt"]
    },
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Global homepage copy, team introduction, and 3 heritage cluster definitions.",
      "type": "object",
      "properties": {
        "tenDuAn": { "type": "string", "minLength": 1, "maxLength": 180 },
        "tenPhu": { "type": "string", "maxLength": 200 },
        "khauHieu": { "type": "string", "maxLength": 500 },
        "anhBia": { "type": "string", "maxLength": 350000 },
        "nhomThucHien": { "type": "object" },
        "clusters": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tenDuAn", "tenPhu", "khauHieu", "anhBia", "nhomThucHien", "clusters", "updatedAt"]
    },
    "AboutPage": {
      "title": "AboutPage",
      "description": "Rich HTML content for the Giới thiệu page stored at settings/about.",
      "type": "object",
      "properties": {
        "tieuDe": { "type": "string", "minLength": 1, "maxLength": 200 },
        "phuDe": { "type": "string", "maxLength": 300 },
        "anhBia": { "type": "string", "maxLength": 350000 },
        "noiDungHtml": { "type": "string", "maxLength": 350000 },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tieuDe", "phuDe", "anhBia", "noiDungHtml", "status", "updatedAt"]
    },
    "NewsPost": {
      "title": "NewsPost",
      "description": "STEM heritage news article with rich HTML body and publish/visibility state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tieuDe": { "type": "string", "minLength": 1, "maxLength": 220 },
        "tomTat": { "type": "string", "maxLength": 600 },
        "danhMuc": { "type": "string", "maxLength": 80 },
        "tacGia": { "type": "string", "maxLength": 120 },
        "ngayDang": { "type": "string", "maxLength": 40 },
        "anhBia": { "type": "string", "maxLength": 350000 },
        "noiDungHtml": { "type": "string", "maxLength": 350000 },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "visible": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tieuDe", "tomTat", "danhMuc", "tacGia", "ngayDang", "anhBia", "noiDungHtml", "status", "visible", "updatedAt"]
    }
  },
  "firestore": {
    "/stations/{stationId}": {
      "schema": { "$ref": "#/entities/Station" },
      "description": "Publicly readable 12 STEM heritage stations, editable only by verified admin email."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteConfig" },
      "description": "Publicly readable settings documents (settings/home and settings/about), editable only by verified admin email."
    },
    "/news/{newsId}": {
      "schema": { "$ref": "#/entities/NewsPost" },
      "description": "Publicly readable news posts, editable only by verified admin email."
    }
  }
}
